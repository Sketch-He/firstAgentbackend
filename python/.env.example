APP_NAME=Agent Demo API
API_PREFIX=/api
# Local default; production should be set to your Railway/custom frontend domain.
CORS_ORIGINS_RAW=http://localhost:5174,http://127.0.0.1:5174
# Local default; on Railway with a volume, prefer `/data/agent_demo.db`.
SQLITE_PATH=agent_demo.db
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat
ASSISTANT_SYSTEM_PROMPT=你是一个中文 AI 助手，请优先给出准确、直接、可执行的回答。
REQUEST_TIMEOUT_SECONDS=60
